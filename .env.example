# Softique Website Environment Configuration
# Copy this file to .env to configure SMTP and runtime variables

# Public website details
VITE_SITE_URL=https://softique.in
VITE_WHATSAPP_NUMBER=919313602929
VITE_CONTACT_EMAIL=jmenterprise.softique@gmail.com

# -------------------------------------------------------------
# SMTP Email Server Configuration (Nodemailer)
# -------------------------------------------------------------
# For Gmail (Recommended):
# 1. Enable 2-Step Verification on your Google Account: jmenterprise.softique@gmail.com
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (Name: "Softique Website") -> Copy the 16-character password
# 4. Paste it below as SMTP_PASS without spaces:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jmenterprise.softique@gmail.com
SMTP_PASS=your-gmail-16-character-app-password
SMTP_FROM="Softique Inquiries <jmenterprise.softique@gmail.com>"
SMTP_TO=jmenterprise.softique@gmail.com
